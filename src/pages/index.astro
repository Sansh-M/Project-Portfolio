---
import ComputerLayout from "../layouts/ComputerLayout.astro";
import DosCommandForm from "../components/DosCommandForm.astro";
import QuickNavigation from "../components/QuickNavigation.astro";
---

<ComputerLayout
  title="Sanshray Malhotra | Computer Science Portfolio"

>
  <section class="home-page" aria-labelledby="portfolio-title">
    <div class="home-page__main">
      <header class="terminal-header terminal-header--home">
        <p class="terminal-prompt">C:\PORTFOLIO&gt; open profile.exe</p>
        <h1 id="portfolio-title">Sanshray's Portfolio</h1>
        <p>Bachelor's Computer Science @TU Eindhoven // aspiring full-stack developer</p>
      </header>

      <DosCommandForm autofocus={true} />
    </div>

    <QuickNavigation current="home" />
  </section>
</ComputerLayout>
