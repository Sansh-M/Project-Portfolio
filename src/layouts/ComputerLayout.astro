---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sanshray Malhotra's computer science project portfolio.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <div class="computer-shell">
      <header class="computer-label" aria-hidden="true"></header>

      <div class="computer-display-area">
        <div class="screen-bezel">
          <main class="crt-screen">
            <slot />
          </main>
        </div>

        <div class="side-panel" aria-hidden="true">
          <div class="terminal-badge">
            <span class="terminal-badge__mark">SM</span>
            <span class="terminal-badge__label">Personal Terminal</span>
          </div>

          <div class="monitor-controls">
            <span class="monitor-knob monitor-knob--power"></span>
            <span class="monitor-knob monitor-knob--brightness"></span>
          </div>

          <div class="panel-status-lights">
            <span class="panel-status-light">
              <span class="panel-status-light__lamp panel-status-light__lamp--power"></span>
              <span class="panel-status-light__label">Power</span>
            </span>
            <span class="panel-status-light">
              <span class="panel-status-light__lamp panel-status-light__lamp--ready"></span>
              <span class="panel-status-light__label">Ready</span>
            </span>
          </div>
        </div>
      </div>

      <footer class="computer-controls" aria-hidden="true"></footer>
    </div>
  </body>
</html>
